{
  "name": "doyensys-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "seed": "tsx scripts/seed.ts",
    "create-account": "tsx scripts/createAccount.ts",
    "set-org-branding": "tsx scripts/setOrgBranding.ts",
    "setup-customer": "tsx scripts/setupPetmate.ts",
    "list-users": "tsx scripts/listUsers.ts",
    "remove-user": "tsx scripts/removeUser.ts",
    "set-password": "tsx scripts/setPassword.ts",
    "test-email": "tsx scripts/testEmail.ts",
    "rls:apply": "psql \"$DATABASE_URL\" -f prisma/rls-policies.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.24",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.19.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
