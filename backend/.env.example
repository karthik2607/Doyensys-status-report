NODE_ENV=development
PORT=4000

# Match the role/db/password you already created on your Ubuntu Postgres
DATABASE_URL="postgresql://doyensys_app:CHANGE_ME@localhost:5432/doyensys?schema=public"

# JWT — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="8h"

# Password hashing cost factor (10-12 is a reasonable production range)
BCRYPT_ROUNDS=12

# Email (notifications — in-app + email per product decision)
# Set to "true" to actually send emails via the SMTP settings below.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey-or-username"
SMTP_PASS="smtp-password"
SMTP_FROM="Doyensys Portal <no-reply@doyensys.com>"

# Email-to-ticket ingestion — polls a mailbox (e.g. support@moregroup-inc.com)
# and creates an incident for every unread message from a recognized
# customer account. Set to "true" to enable. Reuses SMTP_USER/SMTP_PASS for
# IMAP login unless IMAP_USER/IMAP_PASS are set separately (useful if
# inbound and outbound use different mailboxes).
EMAIL_INGESTION_ENABLED=false
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASS=""
EMAIL_INGESTION_POLL_SECONDS=60

# Local attachment storage root (created automatically if missing)
ATTACHMENTS_DIR="/opt/doyensys/uploads"

# Where customer logo images live. The API serves them publicly at
# GET /api/logos/<filename> so branding works with no web server involved.
LOGOS_DIR="/opt/doyensys/logos"
ATTACHMENT_MAX_SIZE_MB=25

# Used in email templates (welcome emails, notification links) — set this
# to wherever the portal is actually reachable once you have a domain.
PORTAL_URL=""

# Frontend origin allowed for CORS (your HTML/SPA)
CORS_ORIGIN="https://portal.doyensys.com"
